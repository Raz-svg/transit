{
  "name": "transit",
  "private": true,
  "description": "Informal public transit routing platform (web + API monorepo)",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @transit/shared-types build && pnpm -r --parallel --filter \"./apps/*\" --filter @transit/shared-types dev",
    "dev:web": "pnpm --filter @transit/web dev",
    "dev:server": "pnpm --filter @transit/server dev",
    "dev:driver": "pnpm --filter @transit/driver-portal dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
